# Dockerfile.api — FastAPI backend
#
# Build:  docker build -f Dockerfile.api -t support-platform-api .
# Run:    docker run -p 8000:8000 --env-file .env support-platform-api

FROM python:3.12-slim

WORKDIR /app

# System deps needed by chromadb / sentence-transformers / spacy at runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Optional: pre-download the spaCy model if PII_MASKER_MODE=presidio.
# Comment out if using the default regex-based PII masker (no spaCy needed).
# RUN python -m spacy download en_core_web_sm

COPY common ./common
COPY clients ./clients
COPY services ./services
COPY api ./api

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
