# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Every value has a working default for local dev - nothing here is
# required to boot the API.

# --- api/ - this module's own behaviour (see api/config.py) -----------------
APP_TITLE=AI Agentic Customer Support Platform
APP_VERSION=1.0.0

# DEBUG also logs full request/response bodies (api/middleware.py) -
# unmasked, so don't leave this on outside local dev.
LOG_LEVEL=INFO

# Comma-separated, explicit origins only (not "*" - invalid together with
# CORSMiddleware's allow_credentials=True). Defaults to the Streamlit
# client's dev port.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Max chars of request/response body logged per line at LOG_LEVEL=DEBUG.
LOG_BODY_MAX_CHARS=2000

# Dummy API-key auth (see api/security.py) - stand-in for real JWT bearer
# auth. Blank disables the check entirely - safe to leave blank, unlike
# DATABASE_URL above (there's no fallback being bypassed here).
API_KEY=
# false (default): missing/invalid key is logged, request still proceeds.
# true: missing/invalid key gets a 401. Flip this on once every caller
# (shopassist-client included) is actually sending X-API-Key.
API_KEY_ENFORCE=false

# Wall-clock cap (seconds) on one chat request's orchestrator call - see
# api/routers/chat.py for what this does and doesn't protect against.
# 360 accommodates CPU-only local Ollama inference (no GPU) with every
# *_PROVIDER at its shipped "local" default below: each sub-task the
# task-decomposer produces makes several sequential local calls
# (agent_reason, agent_interpret) before one final generative call, and
# 360 keeps meaningful headroom for that. Lower it if you have GPU
# acceleration, or route GENERATIVE_PROVIDER (and/or others) to Gemini
# below - the configuration this project was actually developed and
# tuned against, and notably faster.
CHAT_REQUEST_TIMEOUT_SECONDS=360

# Max chat requests per minute per API key (or client IP if none). In-memory,
# per-process only - see api/rate_limit.py. <= 0 disables it.
RATE_LIMIT_PER_MINUTE=30

# --- services/llm_inference.py - LLM provider --------------------------------
# Ollama server, OpenAI-compatible endpoint. Each model below must be a tag
# actually pulled into that Ollama instance (`ollama list`), or every
# router/agent/generative call 404s with "model '<name>' not found".
#
# Leave OLLAMA_API_BASE_URL commented out (both here and running via
# Docker Compose): unset, services/llm_inference.py itself defaults to
# http://localhost:11434 (correct for `uvicorn`/`main_simulation.py` run
# directly on the host), and docker-compose.yml separately defaults the
# containerized api to http://host.docker.internal:11434 (an Ollama you
# install yourself - this repo's docker-compose.yml doesn't bundle one;
# see README.md's Docker section). A single fixed value here can't be
# correct for both run modes at once.
# OLLAMA_API_BASE_URL=http://localhost:11434
# OLLAMA_API_BASE_URL=http://host.docker.internal:11434
# llama3.2:3b - install Ollama yourself and `ollama pull` this tag (and
# nomic-embed-text below) before running `docker compose up` or
# main_simulation.py/uvicorn directly - see README.md's Docker section.
# Change SHOPASSIST_MODEL in the Docker Compose case instead of these four
# directly - see docker-compose.yml's `api` service.
OLLAMA_ROUTER_MODEL=llama3.2:3b
OLLAMA_AGENT_REASON_MODEL=llama3.2:3b
OLLAMA_AGENT_INTERPRET_MODEL=llama3.2:3b
OLLAMA_GENERATIVE_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- services/llm_inference.py - hybrid local/cloud routing ------------------
# Each of ROUTER / AGENT_REASON / AGENT_INTERPRET / GENERATIVE independently
# defaults to "local" (the Ollama config above) and can be switched to
# Gemini per-role. A typical hybrid setup: leave the frequent routing/tool-
# selection steps on the free local model, and point only the customer-
# facing step at the paid cloud model:
#   GENERATIVE_PROVIDER=gemini
# ROUTER_PROVIDER=local
# AGENT_REASON_PROVIDER=local
# AGENT_INTERPRET_PROVIDER=local
# GENERATIVE_PROVIDER=local

# Required only once some *_PROVIDER above is set to "gemini" - see
# https://ai.google.dev/gemini-api/docs/openai. Leave blank while everything
# stays local; LLMInferenceService never even constructs the Gemini client
# in that case; a role set to "gemini" without this raises at startup.
# GEMINI_API_KEY=
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_ROUTER_MODEL=gemini-2.5-flash
# GEMINI_AGENT_REASON_MODEL=gemini-2.5-flash
# GEMINI_AGENT_INTERPRET_MODEL=gemini-2.5-flash
# GEMINI_GENERATIVE_MODEL=gemini-2.5-pro

# Only read by services/llm_inference.py's own __main__ block - leave
# commented out unless calling the real OpenAI API directly. Keep it
# commented, not blank: `OPENAI_API_KEY=` still sets the var to "".
# OPENAI_API_KEY=

# --- services/classifier_client.py - sentiment/tone classification ----------
# Separate encoder-model (BERT-style) service from shopassist-model/classifier/
# - see that repo's README. Optional: ClassifierClient fails soft to
# label="unknown" if this isn't reachable, so leaving it un-started doesn't
# break chat or product-catalog ingestion. Default already matches where
# shopassist-model's docker-compose publishes it.
CLASSIFIER_API_BASE_URL=http://localhost:8100
CLASSIFIER_TIMEOUT_SECONDS=5

# --- clients/ecommerce_api_client.py - order/customer DB --------------------
# Leave commented out to use the local SQLite dev DB (db/shopassist.db,
# built by `python db/init_db.py`). Keep it commented, not blank: an empty
# DATABASE_URL is a set env var, not an unset one, so the code's SQLite
# fallback never kicks in and create_engine() crashes on startup.
# DATABASE_URL=postgresql://shopassist:shopassist123@localhost:5432/shopassist
