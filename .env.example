# ============================================================
# AI Agentic Customer Support Platform - Environment Config
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- LLM Provider ---
# "groq"      -> public API, fast inference (needs GROQ_API_KEY)
# "ollama"    -> local inference via a running Ollama server (no API key)
# "anthropic" -> Anthropic API (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=groq

# Groq (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (run `ollama serve` + `ollama pull llama3` locally first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Anthropic (optional alternate provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-4-6

# --- LLM Token Limits ---
LLM_ROUTER_MAX_TOKENS=512
LLM_GENERATIVE_MAX_TOKENS=1024
LLM_AGENT_REASON_MAX_TOKENS=1024
LLM_AGENT_INTERPRET_MAX_TOKENS=1024

# --- Embeddings (local, no API key needed) ---
# "huggingface"   -> sentence-transformers model (default, matches Tech Stack spec)
# "deterministic" -> zero-dependency offline placeholder (dev/testing only)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Alternate: EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Vector Store ---
# "chroma" (default) | "faiss"
VECTOR_STORE=chroma

# ChromaDB
CHROMA_MODE=local
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=ecommerce_support_kb

# FAISS (only used if VECTOR_STORE=faiss)
FAISS_PERSIST_DIR=./faiss_index

# --- RAG Settings ---
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.3

# --- PII Masking ---
PII_MASKER_MODE=regex

# --- Evaluation Framework targets (see services/evaluation.py) ---
EVAL_CONTEXT_RECALL_TARGET=0.75
EVAL_CONTEXT_PRECISION_TARGET=0.75
EVAL_FAITHFULNESS_TARGET=0.80
EVAL_ANSWER_RELEVANCE_TARGET=0.75
EVAL_BERTSCORE_F1_TARGET=0.75
EVAL_MAX_LATENCY_SECONDS=5.0
EVAL_MAX_HALLUCINATION_RATE=0.15
EVAL_MIN_WORKFLOW_COMPLETION=0.85

# --- Observability ---
# Set to "true" (+ add LANGCHAIN_API_KEY) to enable LangSmith tracing —
# zero code changes needed since all LLM calls go through LangChain.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
