# Dockerfile.streamlit — Streamlit frontend
#
# Build:  docker build -f Dockerfile.streamlit -t support-platform-ui .
# Run:    docker run -p 8501:8501 -e API_BASE_URL=http://api:8000 support-platform-ui

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir streamlit requests

COPY streamlit_app ./streamlit_app

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8501/_stcore/health').raise_for_status()" || exit 1

CMD ["streamlit", "run", "streamlit_app/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
